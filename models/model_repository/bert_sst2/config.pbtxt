name: "bert_sst2"
backend: "onnxruntime"
max_batch_size : 8
input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

# dynamic_batching {
#     preferred_batch_size: [4, 8]
#     max_queue_delay_microseconds: 1000
# }